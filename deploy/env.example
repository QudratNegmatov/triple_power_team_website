# Copy to /srv/tpt/.env and fill in. Read by systemd (tpt.service) and deploy.sh.
# Plain KEY=value lines, no quotes, no spaces around "=".

DJANGO_DEBUG=False
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Postgres on this same server.
DATABASE_URL=postgresql://tpt_user:PASSWORD@localhost:5432/tpt_db

# Optional: keep uploaded images on Cloudinary. Leave these out to store
# uploads on this server under /srv/tpt/app/media/ (served by Nginx).
#CLOUDINARY_CLOUD_NAME=
#CLOUDINARY_API_KEY=
#CLOUDINARY_API_SECRET=
