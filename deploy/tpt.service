# systemd unit for the site's gunicorn process.
# Install: sudo cp deploy/tpt.service /etc/systemd/system/ && sudo systemctl enable --now tpt
[Unit]
Description=Triple Power Team website (gunicorn)
After=network.target postgresql.service

[Service]
User=tpt
Group=www-data
WorkingDirectory=/srv/tpt/app
EnvironmentFile=/srv/tpt/.env
RuntimeDirectory=tpt
ExecStart=/srv/tpt/venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind unix:/run/tpt/gunicorn.sock \
    --umask 007 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure

[Install]
WantedBy=multi-user.target
